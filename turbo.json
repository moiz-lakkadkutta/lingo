{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NODE_ENV",
    "PORT",
    "AWS_REGION",
    "BEDROCK_REGION",
    "S3_BUCKET_MEDIA",
    "CLOUDFRONT_DOMAIN",
    "NOVA_LITE_MODEL_ID",
    "ADMIN_TOKEN",
    "RVS_BASE",
    "RVS_ENV",
    "RVS_SHARED_SECRET",
    "LINGO_PLUS_MODE",
    "LINGO_ALLOW_UNSAFE_PLUS",
    "PHONE_URL",
    "LOG_LEVEL",
    "LINGO_PYTHON",
    "LINGO_AI_CACHE_DIR",
    "LINGO_AI_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "cdk.out/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
