{
  "expo": {
    "name": "Lingo",
    "slug": "lingo",
    "scheme": "lingo",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0F151B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0F151B",
      "resizeMode": "contain"
    },
    "android": {
      "package": "dev.moizp.lingo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F151B"
      },
      "backgroundColor": "#0F151B",
      "usesCleartextTraffic": true,
      "permissions": [],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LEANBACK_LAUNCHER",
            "LAUNCHER"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "lingo",
              "host": "clip"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "../../packages/shared-ui/assets/fonts/NotoSans-Regular.ttf",
            "../../packages/shared-ui/assets/fonts/NotoSans-SemiBold.ttf",
            "../../packages/shared-ui/assets/fonts/Manrope-ExtraBold.ttf"
          ]
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/tv-banner.png"
        }
      ],
      "./plugins/withKeyDownEvents",
      "./plugins/withAmazonIap"
    ]
  }
}
