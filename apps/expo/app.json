{
  "expo": {
    "name": "Lingo",
    "slug": "lingo",
    "scheme": "lingo",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "dev.moizp.lingo",
      "usesCleartextTraffic": true,
      "permissions": [],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LEANBACK_LAUNCHER",
            "LAUNCHER"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "lingo",
              "host": "clip"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "@react-native-tvos/config-tv",
      "./plugins/withKeyDownEvents",
      "./plugins/withAmazonIap"
    ]
  }
}
