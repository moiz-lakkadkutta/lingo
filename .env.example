DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lingo
PORT=4000
# Base of the join link in the TV's pair QR (apps/api/src/routes/sessions.ts). Unset = lingo://join/<code> for the native phone app;
# http://<lan-ip>:8083/join = the phone app served as a web page, which joins by itself when the phone's camera opens the link.
# PHONE_URL=
# apps/api sets this itself: `dev` runs with development, `start` with production. Any value other than development or test,
# unset included, makes the Lingo Plus guard below strict (apps/api/src/lib/env.ts, decision 0012 §6).
# NODE_ENV=development

# --- Lingo Plus (decision 0012) ---
# iap = verify receipts with Amazon RVS; demo = everyone has Plus; off = nobody has Plus (RVS_ENV is then not needed).
LINGO_PLUS_MODE=iap
# Required whenever LINGO_PLUS_MODE is not off: sandbox (the RVS Cloud Sandbox, accepts App Tester test receipts) or production.
# Outside NODE_ENV=development/test the API refuses to start with sandbox, demo, the default secret or an RVS_BASE override.
RVS_ENV=sandbox
# The Developer Console shared key for production RVS. The sandbox accepts any non-empty value; never logged, never committed.
RVS_SHARED_SECRET=sandbox
# Optional: override the RVS endpoint (e.g. a local RVS for tests). With RVS_ENV=production only https://appstore-sdk.amazon.com passes.
# RVS_BASE=
# true starts the API anyway with an unsafe Plus setup and logs each problem at startup. Leave unset for any deploy.
# LINGO_ALLOW_UNSAFE_PLUS=
AWS_REGION=eu-central-1
BEDROCK_REGION=us-east-1
# the MediaBucket output of the lingo-media-dev stack: lingo-media-<stage>-<account> (infra/lib/media-stack.ts).
# Left empty on purpose: the batch refuses to run while it is unset, so fill in the real bucket name before a run.
S3_BUCKET_MEDIA=
CLOUDFRONT_DOMAIN=
# Local media when CLOUDFRONT_DOMAIN is empty: manifests become MEDIA_BASE_URL/<key>. `pnpm media:dev` serves ./media on :8090.
# Blank = http://localhost/<key>. On a Fire TV: adb reverse tcp:8090 tcp:8090 (apps/expo/README.md).
MEDIA_BASE_URL=
# Bedrock model for glosses and the quiz plan (docs/aws.md, "Bedrock / Nova Lite"). Wins over NOVA_LITE_MODEL_ID; blank = Nova Pro v1,
# the measured default (decision 0009). Must have a MODEL_PRICES entry (packages/pipeline/src/ai/cost.ts), e.g. us.amazon.nova-lite-v1:0.
LINGO_AI_MODEL=us.amazon.nova-pro-v1:0
# Older name, read only when LINGO_AI_MODEL is blank.
NOVA_LITE_MODEL_ID=us.amazon.nova-lite-v1:0
# Nova Lite response cache (LING-002); blank = packages/pipeline/data/.cache/ai
LINGO_AI_CACHE_DIR=
# Python with simplemma==2.0.0 for the pipeline lemmatizer; default: <repo>/.venv-lemma/bin/python if present, else python3
LINGO_PYTHON=
